# Copia este archivo a .env.local y rellena lo que vayas a usar.
# .env.local NO se sube al repositorio: es donde viven los datos que no deben
# quedar en GitHub. Vite solo expone las variables que empiezan por VITE_.

# Servicio que recibe el formulario de contacto y la encuesta.
# Formspree:  https://formspree.io/f/xxxxxxx
# Web3Forms:  https://api.web3forms.com/submit   (la clave va en el propio form)
VITE_ENDPOINT_FORMULARIO=

# Correo de respaldo, usado solo si no hay endpoint.
# Recomendado: un alias de reenvío, no la dirección personal.
VITE_CORREO_CONTACTO=
